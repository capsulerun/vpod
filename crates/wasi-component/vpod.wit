package vpod:sandbox@0.2.0;

world library {
    export executor;
}

interface executor {
    record execution-result {
        stdout: string,
        stderr: string,
        exit-code: u32,
    }

    record slice-output {
        stdout: string,
        stderr: string,
        exit-code: option<u32>,
    }

    record mount-entry {
        host-alias: string,
        guest-path: string,
        writable: bool,
    }

    record env-var {
        name: string,
        value: string,
    }

    enum exec-mode { closed, piped, terminal }

    record trace-options {
        processes: bool,
        files: bool,
        network: bool,
        mounts: bool,
        buffer-bytes: u32,
    }

    session-start: func(snapshot-path: string, command: string, prompt: string, mounts: list<mount-entry>, env: list<env-var>) -> result<u64, string>;
    session-exec: func(handle: u64, code: string, timeout: option<u64>) -> result<execution-result, string>;
    session-close: func(handle: u64);


    session-exec-slice: func(handle: u64, code: option<string>, timeout: option<u64>, slice-nanos: u64, mode: exec-mode) -> result<slice-output, string>;
    session-interrupt: func(handle: u64) -> result<_, string>;
    session-stdin: func(handle: u64, data: list<u8>) -> result<_, string>;

    session-suspend: func(handle: u64, delta-path: string) -> result<u64, string>;
    session-resume: func(snapshot-path: string, delta-path: string, command: string, prompt: string, mounts: list<mount-entry>, env: list<env-var>) -> result<u64, string>;

    session-trace-start: func(handle: u64, options: trace-options) -> result<_, string>;
    session-trace-drain: func(handle: u64, max-bytes: u32) -> result<string, string>;
    session-trace-stop: func(handle: u64) -> result<_, string>;
}
