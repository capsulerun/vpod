{
  "name": "@capsule-run/vpod",
  "version": "0.6.0",
  "description": "Lightweight, secure sandboxes for untrusted processes. Browser and Node.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:component": "node scripts/transpile.mjs",
    "clean": "rm -rf dist",
    "dev": "node dev/serve.mjs",
    "bench": "node dev/run-browser.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.11.1",
    "@bytecodealliance/preview2-shim": "^0.17.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
